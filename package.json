{
  "name": "blog-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "author": "concurrently -k -n next,api -c \"blue,green\" \"next dev\" \"python3 -m backend.server\"",
    "author:server": "python3 -m backend.server",
    "setup:env": "node scripts/setup-env.mjs",
    "build": "npm run export:metadata && next build && node scripts/isolate-static.mjs",
    "build:export": "npm run build && node scripts/export-build.mjs",
    "build:timestamp": "node scripts/add-build-timestamp.mjs",
    "publish:timestamp": "node scripts/publish-with-timestamp.mjs",
    "push-static": "node scripts/publish-with-timestamp.mjs",
    "preview": "serve -s .static-out",
    "export:metadata": "python3 -m backend.export_metadata",
    "export:copy": "node scripts/export-build.mjs",
    "projects:validate": "node scripts/validate-projects.mjs",
    "smoke:author": "node scripts/smoke-author.mjs",
    "smoke:export": "node scripts/smoke-export.mjs",
    "smoke:views": "node scripts/smoke-views.mjs",
    "test": "./env/bin/python -m pytest backend/tests -v",
    "test:backend": "./env/bin/python -m pytest backend/tests -v",
    "data:hard-reset": "python3 -m backend.reset_data hard",
    "data:reset-minimal": "python3 -m backend.reset_data minimal",
    "data:reset-example": "python3 -m backend.reset_data example",
    "lint": "next lint"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.563.0",
    "marked": "^14.0.0",
    "next": "14.2.5",
    "next-themes": "^0.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^4.5.9",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.0.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.5.6",
    "serve": "^14.2.1",
    "shadcn": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3"
  }
}
